{{ 'section-hero.css' | asset_url | stylesheet_tag }}
<section id="shopify-{{ section.id }}">
<div
  class="hero hero-slider"
  data-section-id="{{ section.id }}"
  style="
    --hero-height: {{ section.settings.hero_height }}px;
    --hero-height-mobile: {{ section.settings.hero_height_mobile }}px;
  "
>
  <div class="hero-slider__wrapper">

    {% for block in section.blocks %}
      <div
        class="hero-slide{% if forloop.first %} is-active{% endif %}"
        {{ block.shopify_attributes }}
        data-slide="{{ forloop.index0 }}"
      >

        <div class="hero__media">

          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'hero__image',
                loading: 'lazy'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
          {% endif %}

          {% if block.settings.overlay %}
            <div
              class="hero__overlay"
              style="
                background: {{ block.settings.overlay_color }};
                opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
              "
            ></div>
          {% endif %}

        </div>

        <div
          class="hero__content"
          style="--hero-text-color: {{ block.settings.text_color }};"
        >

          {% if block.settings.heading_type == 'image' %}
            {% if block.settings.heading_image != blank %}
                <img
                src="{{ block.settings.heading_image | image_url: width: 1000 }}"
                alt="{{ block.settings.heading_image.alt | escape }}"
                class="hero__headline-image"
                loading="lazy"
                >
            {% endif %}
            {% else %}
            {% if block.settings.heading != blank %}
                <h2
                class="hero__headline"
                style="color: {{ block.settings.heading_color }};"
                >
                {{ block.settings.heading }}
                </h2>
            {% endif %}
            {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="hero__button"
              style="
                background: {{ block.settings.button_color }};
                color: {{ block.settings.button_text_color }};
              "
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}

        </div>

      </div>
    {% endfor %}

  </div>

  {% if section.settings.show_arrows %}
    <button class="hero-slider__arrow hero-slider__prev" type="button">
      &#10094;
    </button>

    <button class="hero-slider__arrow hero-slider__next" type="button">
      &#10095;
    </button>
  {% endif %}

  {% if section.settings.show_dots %}
    <div class="hero-slider__dots">
      {% for block in section.blocks %}
        <button
          type="button"
          class="hero-slider__dot{% if forloop.first %} is-active{% endif %}"
          data-slide-to="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}

</div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const slider = document.querySelector('.hero-slider');

  if (!slider) return;

  const slides = slider.querySelectorAll('.hero-slide');
  const dots = slider.querySelectorAll('.hero-slider__dot');
  const prev = slider.querySelector('.hero-slider__prev');
  const next = slider.querySelector('.hero-slider__next');

  let currentSlide = 0;

  function showSlide(index) {
    if (!slides.length) return;

    currentSlide = (index + slides.length) % slides.length;

    slides.forEach((slide, i) => {
      slide.classList.toggle('is-active', i === currentSlide);
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === currentSlide);
    });
  }

  if (next) {
    next.addEventListener('click', function () {
      showSlide(currentSlide + 1);
    });
  }

  if (prev) {
    prev.addEventListener('click', function () {
      showSlide(currentSlide - 1);
    });
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', function () {
      showSlide(i);
    });
  });

  {% if section.settings.autoplay %}
    setInterval(function () {
      showSlide(currentSlide + 1);
    }, {{ section.settings.autoplay_speed | times: 1000 }});
  {% endif %}
});
</script>
{% schema %}
{
  "settings": [
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop banner height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Mobile banner height",
      "min": 250,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image"
        },
       {
        "type": "select",
        "id": "heading_type",
        "label": "Heading type",
        "options": [
            {
            "value": "text",
            "label": "Text"
            },
            {
            "value": "image",
            "label": "Image"
            }
        ],
        "default": "text"
        },
        {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "New Collection"
        },
        {
        "type": "image_picker",
        "id": "heading_image",
        "label": "Heading image"
        },
        {
        "type": "color",
        "id": "heading_color",
        "label": "Heading text color",
        "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#111111"
        },
        {
          "type": "checkbox",
          "id": "overlay",
          "label": "Enable overlay",
          "default": true
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}